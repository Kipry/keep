<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults: reads the project snapshot written by the main app
             via the shared App Group container (group.com.kipry.keep.app). -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- 1C8F.1: data shared with other members of the same App
                     Group. This is the extension's only UserDefaults access,
                     and CA92.1 (app-only data) was declared for it by mistake. -->
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required bundle keys -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>keep.</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Export compliance: the app does no networking and uses only exempt
         standard encryption, so it is exempt from export documentation. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Privacy permissions -->
    <key>NSCameraUsageDescription</key>
    <string>keep. needs camera access to record your daily moments.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>keep. needs microphone access to capture audio with your clips.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>keep. needs photo library access to import existing videos.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>keep. needs permission to save compiled videos to your photo library.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>keep. uses your location to remember where each moment was captured.</string>

    <!-- Device requirements -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>video-camera</string>
        <string>microphone</string>
    </array>

    <!-- URL scheme for widget deep links -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>keep</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.kipry.keep.app</string>
        </dict>
    </array>

    <!-- Scene support -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- Launch screen. Without a colour this defaults to white, which flashed
         before the first (always dark) frame of the app. Deliberately not
         appearance-dependent: every view forces preferredColorScheme(.dark),
         so a light launch screen would flash into a dark UI whatever the
         system setting. #0D0D0D matches Theme.background exactly, making the
         handover seamless. -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
        <key>UIImageRespectsSafeAreaInsets</key>
        <true/>
    </dict>

    <!-- Supported interface orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>

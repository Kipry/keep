    "Remembers where each clip was captured — shown on the Places map. \"Nearby\" stores only the rough area (~1 km). Everything stays on your device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkt sich, wo jeder Clip aufgenommen wurde — sichtbar auf der Orte-Karte. „Ungefähr\" speichert nur die grobe Umgebung (~1 km). Alles bleibt auf deinem Gerät."
          }
        }
      }
    },

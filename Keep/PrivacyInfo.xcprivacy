<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App does not perform cross-app or cross-website tracking -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking domains -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- No data is collected or transmitted to any server.
         All video clips and project data remain on-device only. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- APIs accessed with required reason codes -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults: used via App Group to share the active project
             snapshot with the home screen widget (WidgetDataStore.swift).
             Reason CA92.1: read/write info accessible only within the app
             and its associated app extensions. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: data accessible only to the app itself
                     (defaultRecordingDuration, locationGranularity, didOnboard) -->
                <string>CA92.1</string>
                <!-- 1C8F.1: data shared with app extensions in the same App
                     Group (the widget snapshot via WidgetDataStore) -->
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
